{
  "name": "@hybr1d-tech/charizard",
  "version": "3.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": "./dist/assets/charizard.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Usehybrid/charizard"
  },
  "scripts": {
    "dev": "vp dev -c vite.site.config.ts",
    "build": "tsc && vp build",
    "watch": "vp build --watch",
    "site:build": "node scripts/extract-props.mts && node scripts/generate-changelog.mts && node scripts/fetch-repo-meta.mts && node scripts/generate-manifest.mts && vp build -c vite.site.config.ts",
    "site:manifest": "node scripts/generate-manifest.mts",
    "site:props": "node scripts/extract-props.mts",
    "site:changelog": "node scripts/generate-changelog.mts",
    "site:repo": "node scripts/fetch-repo-meta.mts",
    "site:preview": "vp preview -c vite.site.config.ts",
    "fixtures:snapshot": "node scripts/snapshot-fixtures.mts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-table": "^9.1.2",
    "@zag-js/accordion": "^1.43.1",
    "@zag-js/checkbox": "^1.43.1",
    "@zag-js/color-picker": "^1.43.1",
    "@zag-js/combobox": "^1.43.1",
    "@zag-js/dialog": "^1.43.1",
    "@zag-js/menu": "^1.43.1",
    "@zag-js/pagination": "^1.43.1",
    "@zag-js/popover": "^1.43.1",
    "@zag-js/popper": "^1.43.1",
    "@zag-js/radio-group": "^1.43.1",
    "@zag-js/react": "^1.43.1",
    "@zag-js/select": "^1.43.1",
    "@zag-js/switch": "^1.43.1",
    "@zag-js/tabs": "^1.43.1",
    "@zag-js/tooltip": "^1.43.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-inlinesvg": "^4.5.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^6.0.8",
    "use-deep-compare-effect": "^1.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plus": "catalog:",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
