        "required": false
      },
      {
        "name": "pinningConfig",
        "type": "{ columnPinning: ColumnPinningState; setColumnPinning: Dispatch<SetStateAction<ColumnPinningState>>; }",
        "required": false
      },
      {
        "name": "rowSelectionConfig",
        "type": "{ isCheckbox?: boolean | undefined; isRadio?: boolean | undefined; entityName: string; actions?: { iconSrc: string; label: string; onClick: any; }[] | undefined; setSelectedRows?: Dispatch<any> | undefined; iconSrc?: string | undefined; clearOnSearch?: boolean | undefined; rowIdKey: string; rowSelection?: {} | undefined; setRowSelection?: Dispatch<SetStateAction<{}>> | undefined; }",
